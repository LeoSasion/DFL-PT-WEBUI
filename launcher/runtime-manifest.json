{
  "$schema": "./runtime-manifest.schema.json",
  "schemaVersion": 3,
  "manifestVersion": "2026.10.29.1",
  "description": "DFL-PT-WEBUI local runtimes: Python 3.12, PyTorch 2.9.1 with CUDA 12.6 for Pascal or CUDA 12.8 for modern GPUs.",
  "components": [
    {
      "id": "node",
      "displayName": "Node.js",
      "required": true,
      "available": false,
      "version": "24.19.0",
      "install": {
        "relativePath": "_internal/node",
        "layout": "local"
      },
      "validation": {
        "files": [
          {
            "path": "bin/node.exe",
            "minBytes": 1024
          },
          {
            "path": "bin/npm.cmd",
            "minBytes": 32
          }
        ],
        "command": {
          "path": "bin/node.exe",
          "arguments": [
            "-p",
            "process.versions.node"
          ],
          "outputRegex": "^24\\.19\\.0$"
        }
      }
    },
    {
      "id": "python",
      "displayName": "Python / PyTorch",
      "required": true,
      "available": false,
      "version": "3.12-torch-2.9.1-cu126-or-cu128",
      "install": {
        "relativePath": ".venv",
        "layout": "local"
      },
      "validation": {
        "files": [
          {
            "path": "Scripts/python.exe",
            "minBytes": 1024
          },
          {
            "path": "Lib/site-packages/torch",
            "kind": "directory"
          }
        ],
        "command": {
          "path": "Scripts/python.exe",
          "arguments": [
            "-I",
            "-B",
            "-c",
            "import pathlib,runpy,sys; root=pathlib.Path(sys.executable).resolve().parents[2]; sys.argv=['torch-runtime.py','validate']; runpy.run_path(str(root/'tools'/'torch-runtime.py'),run_name='__main__')"
          ],
          "outputRegex": "^DFL_PT_RUNTIME_OK\\|3\\.12\\.[0-9]+\\|(?:2\\.9\\.1\\+cu126\\|12\\.6|2\\.9\\.1\\+cu128\\|12\\.8)$"
        }
      }
    },
    {
      "id": "ffmpeg",
      "displayName": "FFmpeg",
      "required": true,
      "available": false,
      "version": "project-local",
      "install": {
        "relativePath": "_internal/ffmpeg",
        "layout": "local"
      },
      "validation": {
        "files": [
          {
            "path": "ffmpeg.exe",
            "minBytes": 1024
          },
          {
            "path": "ffprobe.exe",
            "minBytes": 1024
          }
        ]
      }
    }
  ]
}
